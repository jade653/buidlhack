# NEAR network: "testnet" or "mainnet"
NEAR_NETWORK_ID=testnet

# The deployed NEAR contract address
AGENT_CONTRACT_ID=your-challenge-contract.testnet

# Sponsor account — funds the ephemeral TEE agent account.
# This account must have enough NEAR to cover agent registration + calls.
# Generate with: near generate-key sponsor.testnet
SPONSOR_ACCOUNT_ID=sponsor.testnet
SPONSOR_PRIVATE_KEY=ed25519:YOUR_PRIVATE_KEY_HERE

# Shared secret between the TS agent and the Python engine (same container).
# Python sets this header on every call: x-internal-secret: $INTERNAL_SECRET
INTERNAL_SECRET=change-me-to-a-random-string

# HTTP port the agent listens on inside the container
PORT=3000
